# Local dev needs NONE of this: with no .env the API runs on an embedded
# Postgres (apps/api/.data), a dev JWT secret, and shows verification/reset links
# on screen. Everything below is for production (or opting in early).

# Supabase transaction pooler (:6543). Then: pnpm --filter api db:migrate
# DATABASE_URL=postgres://user:pass@pooler-host:6543/postgres

# Auth — required in production. 32+ random chars.
# JWT_SECRET=

# Where the web app is served; verification/reset links point here.
# APP_URL=https://app.example.com
# API_URL=https://api.example.com  # only if the API is hosted separately
# Lock the API to the web app's origin (comma-separated). Unset = any origin.
# CORS_ORIGIN=https://app.example.com

# Optional address search in a booking's Location field: OFF unless set.
# A Google Maps Platform key with "Places API (New)" enabled. Server-side only: never use a VITE_ variable.
# GOOGLE_MAPS_API_KEY=

# Optional Google sign-in: OFF unless both server-side values are set.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# Google OAuth authorized redirect URI for the production deployment:
# https://sorted-weld.vercel.app/api/auth/google/callback
# Uses API_URL when set, otherwise APP_URL. Local: http://localhost:3001/api/auth/google/callback

# Login emails via Resend. Without a key, only local mode logs/returns links;
# production returns 502 rather than claiming an email was sent.
# RESEND_API_KEY=re_...
# EMAIL_FROM=Sorted <login@example.com>

# n8n — turns on WhatsApp/calendar automation (see automation/n8n/README.md)
# N8N_WEBHOOK_URL=https://your-n8n.app/webhook/sorted-events
# INTERNAL_SECRET=shared-secret-for-n8n-callbacks

# Stripe — turns on card payment links (test keys until launch)
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
