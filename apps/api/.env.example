# Local dev needs NONE of this: with no .env the API runs on an embedded
# Postgres (apps/api/.data), a dev JWT secret, and hands login links straight
# to the login screen. Everything below is for production (or opting in early).

# Postgres — https://neon.tech. Then: pnpm --filter api db:migrate
# DATABASE_URL=postgres://user:pass@host/db

# Auth — required in production. 32+ random chars.
# JWT_SECRET=

# Where the web app is served; login links point here.
# APP_URL=https://app.example.com
# Lock the API to the web app's origin (comma-separated). Unset = any origin.
# CORS_ORIGIN=https://app.example.com

# Login emails via Resend. Without a key, links are logged instead.
# RESEND_API_KEY=re_...
# EMAIL_FROM=Sorted <login@example.com>

# n8n — turns on WhatsApp/calendar automation (see automation/n8n/README.md)
# N8N_WEBHOOK_URL=https://your-n8n.app/webhook/sorted-events
# INTERNAL_SECRET=shared-secret-for-n8n-callbacks

# Stripe — turns on card payment links (test keys until launch)
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
