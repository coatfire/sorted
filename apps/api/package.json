{
  "name": "api",
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/local.ts",
    "build": "esbuild src/lambda.ts --bundle --platform=node --target=node20 --format=esm --external:@electric-sql/pglite --outfile=dist/index.mjs --banner:js=\"import { createRequire } from 'module'; const require = createRequire(import.meta.url);\"",
    "db:studio": "drizzle-kit studio",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "test": "vitest run"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.16",
    "@hono/node-server": "^1.13.0",
    "@neondatabase/serverless": "^0.10.0",
    "@sorted/core": "workspace:*",
    "drizzle-orm": "^0.36.0",
    "hono": "^4.6.0",
    "jose": "^5.9.0",
    "stripe": "^17.0.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "drizzle-kit": "^0.28.0",
    "esbuild": "^0.24.0",
    "tsx": "^4.19.0",
    "typescript": "^5.5.0",
    "vitest": "^2.1.9"
  }
}
